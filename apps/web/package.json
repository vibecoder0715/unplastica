{
  "name": "@unplastica/web",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build && node ../../scripts/generate-seo-files.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.json && tsc --noEmit --pretty false -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@unplastica/shared": "workspace:*",
    "@supabase/supabase-js": "^2.57.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-pwa": "^1.0.3",
    "workbox-window": "^7.4.1",
    "vitest": "^3.2.4"
  }
}

